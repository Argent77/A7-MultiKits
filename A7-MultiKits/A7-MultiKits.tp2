/////////////////////////////////
// Customized kit installation //
/////////////////////////////////

BEGIN @200  // User-defined multiclass kits (via A7-MultiKits.ini)
REQUIRE_PREDICATE (GAME_IS ~bgee bg2ee eet iwdee~) @1000  // Enhanced Edition game required.
REQUIRE_PREDICATE (FILE_CONTAINS ~A7-MultiKits/A7-MultiKits.ini~ ~^[ %TAB%]*\[A7-MultiKits\]~ &&
                   FILE_CONTAINS ~A7-MultiKits/A7-MultiKits.ini~ ~^[ %TAB%]*1_class[ %TAB%]*=[ %TAB%]*[0-9a-z_]+~) @1002  // No user-defined kit definitions available.
// GROUP @901  // User-defined kit installation
DESIGNATED 200
LABEL ~A7-MULTIKITS-CUSTOM-INI~

LAF a7#install_custom_multikits
  STR_VAR
    ini_file = ~A7-MultiKits/A7-MultiKits.ini~
    section_name = ~A7-MultiKits~
  RET
    num_installed
END

ACTION_IF (num_installed == 0) BEGIN
  ABORT @1003 // No user-defined kit definitions installed.
END ELSE BEGIN
  OUTER_SPRINT msg @1004  // Number of installed multiclass kits:
  PRINT ~%msg% %num_installed%~
END
