@1000 = ~Wymaga gry w warsji Enhanced Edition.~
@1001 = ~DLC Merger jest wymagany do instalacji modow w tej grze. W pliku readme znajduje sie wiecej informacji oraz link do pobrania DLC Merger.~

// Interactive class selection
// Translators: Text inside angle brackets are placeholders for dynamic text. Do not modify!
@2000 = ~UWAGA: Podano niewlasciwy identyfikator klasy: <class>~
@2001 = ~Nie mozna znalezc klas odpowiadajacych podanym parametrom.~
@2002 = ~Pobieranie informacji o podklasach. To moze potrwac...~
@2003 = ~Kombinacje podklas dostepne dla <class_title>:~
@2004 = ~Wpisz numer wybranej kombinacji (pozostaw puste pole, by kontynuowac instalacje):~
@2005 = ~Wybrany numer nie jest dostepny. Wpisz liczbe miedzy <kit_index_first> a <kit_index_last>, by wybrac kombinacje albo pozostaw puste pole, by kontynuowac instalacje.~
@2006 = ~<option>) <kit_selected><kit_title>~
@2007 = ~<option>) <kit_selected><new_kit_title> (Oryginalna nazwa: <kit_title>)~
@2008 = ~wybrano~
@2009 = ~Liczba kombinacji do zainstalowania: <num_selected>~
@2010 = ~Kontynuuj instalacje ([Y]Tak, [N]Nie, [C]Anuluj)?~
@2011 = ~Wybierz Y, aby zainstalowac wybrane kombinacje, N, aby wrocic do ekranu wyboru lub C, by anulowac operacje.~
@2012 = ~Nie wybrano zadnej kombinacji. Anulowac operacje dla tej klasy ([Y]Tak, [N]Nie)?~
@2013 = ~Wybierz Y, aby anulowac cala operacje lub N, aby wrocic do ekranu wyboru.~
@2014 = ~Anuluj wybor kombinacji "<kit_title>" ([Y]Tak, [N]Nie)?~
@2015 = ~Wybierz Y, aby anulowac wybor obecnej kombinacji lub N, aby ja zachowac.~
@2016 = ~Obecna nazwa: <kit_title>~
@2017 = ~Wpisz nowa nazwe dla wybranej kombinacji podklas (lub pozostaw puste pole, by nie zmieniac):~
@2018 = ~Zatwierdz nazwe "<new_kit_title>" ([A]Akceptuj, [R]Wpisz ponownie, [C]Anuluj)?~
@2019 = ~Wybierz A, aby zaakceptowac, R, aby wpisac nazwe ponownie lub C, aby zachowac nazwe oryginalna.~
@2020 = ~Znaki spoza systemu ASCII sa niedozwolone.~

